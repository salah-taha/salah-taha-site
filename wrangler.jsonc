{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salah-taha-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "salah-taha.com", "custom_domain": true },
    { "pattern": "www.salah-taha.com", "custom_domain": true }
  ]
}
